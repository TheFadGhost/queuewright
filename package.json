{
  "name": "queuewright",
  "version": "0.1.0",
  "description": "A background job queue and scheduler with retries, a worker runtime, and a monitoring dashboard.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "qw": "./dist/cli.js",
    "qw-worker": "./dist/worker-main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dashboard-assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "queue",
    "jobs",
    "background",
    "scheduler",
    "cron",
    "retries",
    "worker",
    "dead-letter"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
